# Copy this file to .env and fill in ONE of the keys below.
# Never commit .env to git.
# Set jev model name, until October 2026, jev-1.14 is the latest version
JEV_MODEL=jev-1.14


# # Option 1: call TypeSafe directly (key from console.typesafe.ai)
# set this option when you buy typesafe ai credits
# TYPESAFE_API_KEY=


# Option 2: call Jev through OpenRouter (key from openrouter.ai/settings/keys)
# set this option when you buy openrouter credits to use typesafe ai
OPENROUTER_API_KEY=<your_openrouter_api_key>
OPENROUTER_BASE_URL=https://openrouter.ai/api
